                    inline_keyboard: [
                        [{ text: `${botState.config.fetchDP  ? '✅' : '❌'} Foto Profil (DP)`, callback_data: 'toggle_dp' }],
                        [{ text: `${botState.config.fetchBio ? '✅' : '❌'} Bio / Status`, callback_data: 'toggle_bio' }],
                        [{ text: `${botState.config.fetchBiz ? '✅' : '❌'} Profil Bisnis`, callback_data: 'toggle_biz' }],
                        [{ text: '🔙 Kembali', callback_data: 'nav_dashboard' }],
