            botState.config.fetchBiz = !botState.config.fetchBiz;
            await teleBot.answerCallbackQuery(id, { text: `Fetch Bisnis: ${botState.config.fetchBiz ? 'ON' : 'OFF'}` });
            await editOrSend(chatId, msgId,
`🔧 *Toggle Fitur Pengambilan Data*`,
                {
                    inline_keyboard: [
                        [{ text: `${botState.config.fetchDP  ? '✅' : '❌'} Foto Profil (DP)`, callback_data: 'toggle_dp' }],
                        [{ text: `${botState.config.fetchBio ? '✅' : '❌'} Bio / Status`, callback_data: 'toggle_bio' }],
                        [{ text: `${botState.config.fetchBiz ? '✅' : '❌'} Profil Bisnis`, callback_data: 'toggle_biz' }],
                        [{ text: '🔙 Kembali', callback_data: 'nav_dashboard' }],
                    ]
                }
            );
            break;

        // ── SET BATCH ──
        case data.startsWith('set_'): {
            const nb = parseInt(data.split('_')[1]);
            botState.config.batch = nb;
            botState.config.delay = nb === 10 ? 5000 : nb === 25 ? 3000 : nb === 50 ? 2000 : 1500;

            let alertTxt  = `✅ Config: Batch ${nb} | Delay ${botState.config.delay/1000}s`;
            let showAlert = false;
            if (nb >= 50) {
                alertTxt  = `⚠️ RISIKO TINGGI!\nBatch ${nb} dapat memicu rate-limit Meta. Gunakan dengan bijak!`;
                showAlert = true;
            }
            await teleBot.answerCallbackQuery(id, { text: alertTxt, show_alert: showAlert });
            await sendDashboard(chatId, msgId);
            break;
        }

        // ── START JOB ──
        case data.startsWith('start_'): {
            const jobId = data.replace('start_', '');
            const list  = botState.jobQueue.get(jobId);
            if (!list)
                return teleBot.answerCallbackQuery(id, { text: '❌ Sesi kadaluarsa. Upload ulang file.', show_alert: true });

            await editOrSend(chatId, msgId,
                `⏳ *Mesin Pengecekan Aktif...*\n\n` +
                `⚙️ *${botState.config.batch} Batch* | ⏱️ *${botState.config.delay/1000}s* Delay\n` +
                `📊 Total: *${list.length}* nomor\n\n_Mohon tunggu..._`
            );
            botState.jobQueue.delete(jobId);
            processBulkCheck(list, botState.config, chatId, msgId);
            break;
        }
    }

    teleBot.answerCallbackQuery(id).catch(() => {});
});

// ─────────────────────────────────────────────
//  CORE: BULK CHECK ENGINE
// ─────────────────────────────────────────────
async function processBulkCheck(numbers, config, chatId, msgId) {
    // Inisialisasi bucket per-tier
    const buckets = {
        biz_exclusive: [],
        biz_standard:  [],
        biz_lowmeta:   [],
        per_premium:   [],
        per_aktif:     [],
        per_kosong:    [],
        dead:          [],
    };

    const total     = numbers.length;
    let   processed = 0;
    let   errCount  = 0;
    const startTime = Date.now();

    for (let i = 0; i < total; i += config.batch) {
        const batchNums = numbers.slice(i, i + config.batch);

        const batchPromises = batchNums.map(async (num, idx) => {
            await delay(idx * 150); // stagger minimal antar nomor dalam batch

            const jid = `${num}@s.whatsapp.net`;
            const res = {
                num,
                isReg:       false,
                isBiz:       false,
                bio:         '-',
                dp:          '-',
                category:    '-',
                description: '-',
                email:       '-',
                website:     '-',
                address:     '-',
                fbPage:      '-',
            };

            try {
                const [waResult] = await sock.onWhatsApp(jid);
                res.isReg = waResult?.exists || false;

                if (res.isReg) {
                    // Fetch Bio
                    if (config.fetchBio) {
                        try {
                            const statusRes = await sock.fetchStatus(jid);
                            res.bio = statusRes?.status || '-';
                        } catch (_) {}
                    }

                    // Fetch DP
                    if (config.fetchDP) {
                        try {
                            res.dp = await sock.profilePictureUrl(jid, 'image') || '-';
                        } catch (_) {}
                    }

                    // Fetch Bisnis
                    if (config.fetchBiz) {
                        try {
                            const biz = await sock.getBusinessProfile(jid);
                            if (biz && Object.keys(biz).length > 0) {
                                res.isBiz       = true;
                                res.category    = biz.category          || '-';
                                res.description = biz.description       || '-';
                                res.email       = biz.email             || '-';
                                res.website     = biz.website?.[0]?.url || '-';
                                res.address     = biz.address           || '-';
                                res.fbPage      = biz.fb_page           || '-';
                            }
                        } catch (_) {}
                    }
                }
            } catch (_) {
                errCount++;
            }

            return res;
        });

        const settled = await Promise.allSettled(batchPromises);

        settled.forEach(({ status, value: res }) => {
            if (status !== 'fulfilled') return;
            const { group } = classifyNumber(res);
            buckets[group].push(res);
        });

        processed += batchNums.length;

        const pct      = Math.round((processed / total) * 100);
        const elapsed  = ((Date.now() - startTime) / 1000).toFixed(0);
        const barLen   = 15;
        const filled   = Math.round((pct / 100) * barLen);
        const bar      = '█'.repeat(filled) + '░'.repeat(barLen - filled);

        // Summary counts live
        const bizTotal = buckets.biz_exclusive.length + buckets.biz_standard.length + buckets.biz_lowmeta.length;
        const perTotal = buckets.per_premium.length   + buckets.per_aktif.length    + buckets.per_kosong.length;
        const deadTotal = buckets.dead.length;

        await editOrSend(chatId, msgId,
`⚙️ *Pengecekan Berlangsung...*

\`[${bar}] ${pct}%\`
📊 *${processed}/${total}* nomor | ⏱️ ${elapsed}s | ⚠️ Error: ${errCount}

🏢 Bisnis   : ${bizTotal}  (🏆${buckets.biz_exclusive.length} │ 💼${buckets.biz_standard.length} │ 📋${buckets.biz_lowmeta.length})
👤 Personal : ${perTotal}  (👑${buckets.per_premium.length} │ ✅${buckets.per_aktif.length} │ ⚪${buckets.per_kosong.length})
❌ Mati     : ${deadTotal}

_Jeda: ${config.delay/1000}s per sesi..._`
        ).catch(() => {});

        if (processed < total) await delay(config.delay);
    }

    // ── LAPORAN AKHIR ──
    const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
    const bizTotal = buckets.biz_exclusive.length + buckets.biz_standard.length + buckets.biz_lowmeta.length;
    const perTotal = buckets.per_premium.length   + buckets.per_aktif.length    + buckets.per_kosong.length;

    await editOrSend(chatId, msgId,
`✅ *PENGECEKAN SELESAI!*
━━━━━━━━━━━━━━━━━━━━
⏱️ Durasi     : *${elapsed} detik*
📊 Total      : *${total}* nomor
⚠️ Error      : *${errCount}*

🏢 *WA BISNIS (${bizTotal})*
  🏆 Exclusive  : *${buckets.biz_exclusive.length}*
  💼 Standard   : *${buckets.biz_standard.length}*
  📋 Low Meta   : *${buckets.biz_lowmeta.length}*

👤 *WA PERSONAL (${perTotal})*
  👑 Premium    : *${buckets.per_premium.length}*
  ✅ Aktif      : *${buckets.per_aktif.length}*
  ⚪ Kosong     : *${buckets.per_kosong.length}*

❌ *Tidak Terdaftar: ${buckets.dead.length}*
━━━━━━━━━━━━━━━━━━━━
📂 Mengirim file hasil...`,
        backBtn()
    );

    // ── KIRIM FILE PER TIER ──
    const fOpts = { contentType: 'text/plain' };
    const ts    = Date.now();

    // Helper format baris
    const fmtBiz = (r) =>
        `Nomor      : +${r.num}\n` +
        `Kategori   : ${r.category}\n` +
        `Deskripsi  : ${r.description}\n` +
        `Email      : ${r.email}\n` +
        `Website    : ${r.website}\n` +
        `Alamat     : ${r.address}\n` +
        `FB Page    : ${r.fbPage}\n` +
        `Bio        : ${r.bio}\n` +
        `Foto Profil: ${r.dp}\n` +
        '─'.repeat(40) + '\n';

    const fmtPer = (r) =>
        `Nomor      : +${r.num}\n` +
        `Bio        : ${r.bio}\n` +
        `Foto Profil: ${r.dp}\n` +
        '─'.repeat(40) + '\n';

    const fmtDead = (r) => `+${r.num}\n`;

    const files = [
        { key: 'biz_exclusive', label: 'WA_Bisnis_EXCLUSIVE',  fmt: fmtBiz  },
        { key: 'biz_standard',  label: 'WA_Bisnis_STANDARD',   fmt: fmtBiz  },
        { key: 'biz_lowmeta',   label: 'WA_Bisnis_LOW_META',   fmt: fmtBiz  },
        { key: 'per_premium',   label: 'WA_Personal_PREMIUM',  fmt: fmtPer  },
        { key: 'per_aktif',     label: 'WA_Personal_AKTIF',    fmt: fmtPer  },
        { key: 'per_kosong',    label: 'WA_Personal_KOSONG',   fmt: fmtPer  },
        { key: 'dead',          label: 'WA_MATI',              fmt: fmtDead },
    ];

    for (const { key, label, fmt } of files) {
        const rows = buckets[key];
        if (rows.length === 0) continue;

        const header = buildFileHeader(label, rows.length, config);
        const body   = rows.map(fmt).join('');
        const buf    = Buffer.from(header + body, 'utf-8');

        await teleBot.sendDocument(chatId, buf, {}, { ...fOpts, filename: `${label}_${ts}.txt` });
        await delay(500); // jeda antar file agar tidak flood
    }
}

// ─────────────────────────────────────────────
//  HELPER: FILE HEADER
// ─────────────────────────────────────────────
function buildFileHeader(label, count, config) {
    const now = new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' });
    return (
        '═'.repeat(45) + '\n' +
        `  WA SUPER CHECKER PRO — ${label}\n` +
        '═'.repeat(45) + '\n' +
        `  Tanggal   : ${now} WIB\n` +
        `  Total     : ${count} nomor\n` +
        `  Batch     : ${config.batch} | Delay: ${config.delay/1000}s\n` +
        '═'.repeat(45) + '\n\n'
    );
}
