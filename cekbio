// ─────────────────────────────────────────────
//  TIER CLASSIFICATION ENGINE
// ─────────────────────────────────────────────
/**
 * Klasifikasi Tier berdasarkan data yang dikumpulkan:
 *
 * BISNIS:
 *   🏆 EXCLUSIVE  — Bisnis + punya DP + punya Bio + kategori terisi
 *   💼 STANDARD   — Bisnis + punya DP atau Bio (salah satu)
 *   📋 LOW META   — Bisnis terdaftar tapi tanpa info apapun
 *
 * PERSONAL:
 *   👑 PREMIUM    — Personal + punya DP + punya Bio panjang (>20 char)
 *   ✅ AKTIF      — Personal + punya DP atau Bio
 *   ⚪ KOSONG     — Personal terdaftar tapi tanpa info apapun
 *
 * TIDAK TERDAFTAR:
 *   ❌ MATI       — Nomor tidak terdaftar di WhatsApp
 */
function classifyNumber(res) {
    if (!res.isReg) {
        return { tier: 'MATI', icon: '❌', label: 'Tidak Terdaftar', group: 'dead' };
    }

    if (res.isBiz) {
        const hasDP  = res.dp  && res.dp  !== '-';
        const hasBio = res.bio && res.bio !== '-';
        const hasCat = res.category && res.category !== '-';
        const hasDesc = res.description && res.description !== '-';

        if (hasDP && hasBio && hasCat) {
            return { tier: 'EXCLUSIVE', icon: '🏆', label: 'WA Bisnis Exclusive', group: 'biz_exclusive' };
        } else if ((hasDP || hasBio) && (hasCat || hasDesc)) {
            return { tier: 'STANDARD', icon: '💼', label: 'WA Bisnis Standard', group: 'biz_standard' };
        } else {
            return { tier: 'LOW META', icon: '📋', label: 'WA Bisnis Low Meta', group: 'biz_lowmeta' };
        }
    } else {
        const hasDP  = res.dp  && res.dp  !== '-';
        const hasBio = res.bio && res.bio !== '-';
        const longBio = hasBio && res.bio.length > 20;

        if (hasDP && longBio) {
            return { tier: 'PREMIUM', icon: '👑', label: 'WA Personal Premium', group: 'per_premium' };
        } else if (hasDP || hasBio) {
            return { tier: 'AKTIF', icon: '✅', label: 'WA Personal Aktif', group: 'per_aktif' };
        } else {
            return { tier: 'KOSONG', icon: '⚪', label: 'WA Personal Kosong', group: 'per_kosong' };
        }
    }
}

// ─────────────────────────────────────────────
//  WHATSAPP CORE
// ─────────────────────────────────────────────
async function startWA(phoneNumberForPairing = null, chatId = null, messageId = null) {
    if (botState.isConnecting) return;
    botState.isConnecting = true;

    const { state, saveCreds } = await useMultiFileAuthState('auth_info_baileys');
    const { version, isLatest } = await fetchLatestBaileysVersion();
    console.log(`WA v${version.join('.')}, isLatest: ${isLatest}`);

    sock = makeWASocket({
        version,
        printQRInTerminal: false,
        browser: Browsers.macOS('Chrome'),
        auth: state,
        logger: pino({ level: 'silent' }),
        markOnlineOnConnect: false,
        generateHighQualityLinkPreview: false,
    });

    sock.ev.on('creds.update', saveCreds);

    if (phoneNumberForPairing && !sock.authState.creds.registered) {
        await editOrSend(chatId, messageId, `⏳ *Menghubungkan ke server Meta...*\nMeminta kode untuk: \`+${phoneNumberForPairing}\``);

        setTimeout(async () => {
            try {
                const code = await sock.requestPairingCode(phoneNumberForPairing);
                const fmt  = code?.match(/.{1,4}/g)?.join('-') || code;
                await editOrSend(chatId, messageId,
                    `✅ *KODE PAIRING:* \`${fmt}\`\n\n` +
                    `1️⃣ Buka WhatsApp di HP\n` +
                    `2️⃣ Buka *Linked Devices*\n` +
                    `3️⃣ Pilih *Link with phone number instead*\n` +
                    `4️⃣ Masukkan kode di atas\n\n` +
                    `_Sistem otomatis mendeteksi jika berhasil._`
                );
            } catch (err) {
                botState.isConnecting = false;
                await editOrSend(chatId, messageId,
                    `❌ *Gagal request kode!*\nError: ${err.message}`,
                    backBtn()
                );
            }
        }, 4000);
    }

    sock.ev.on('connection.update', async (update) => {
        const { connection, lastDisconnect } = update;

        if (connection === 'close') {
            botState.isConnecting = false;
            const code = lastDisconnect?.error?.output?.statusCode;
            const shouldReconnect = code !== DisconnectReason.loggedOut;

            if (shouldReconnect) {
                console.log(`[!] Reconnect dalam 5 detik (status: ${code})`);
                setTimeout(() => startWA(), 5000);
            } else {
                if (fs.existsSync('./auth_info_baileys'))
                    fs.rmSync('./auth_info_baileys', { recursive: true, force: true });
                sock = null;
                teleBot.sendMessage(TELEGRAM_CHAT_ID,
                    "⚠️ *Sesi WhatsApp Dikeluarkan!*\nLogin kembali melalui Dashboard.",
                    { parse_mode: 'Markdown' }
                );
                sendDashboard(TELEGRAM_CHAT_ID);
            }
        } else if (connection === 'open') {
            botState.isConnecting = false;
            console.log('✅ WA Ready!');
            if (chatId) await sendDashboard(chatId, messageId);
            else teleBot.sendMessage(TELEGRAM_CHAT_ID, "✅ *WhatsApp Reconnected!*", { parse_mode: 'Markdown' });
        }
    });
}

// ─────────────────────────────────────────────
